default_platform(:ios)

ENV['LC_ALL'] = 'en_US.UTF-8'
ENV['LANG'] = 'en_US.UTF-8'

PROJECT_PATH = 'romm/romm.xcodeproj'
DEFAULT_SCHEME = 'romm'
DEFAULT_TARGET = 'romm'

private_lane :ensure_required_env_vars! do |options|
  required_keys = options[:keys] || []
  missing_keys = required_keys.select { |key| ENV[key].to_s.strip.empty? }

  return if missing_keys.empty?

  UI.user_error!("Missing required environment variables: #{missing_keys.join(', ')}")
end

private_lane :resolve_app_store_api_key do
  ensure_required_env_vars!(
    keys: %w[
      APP_STORE_CONNECT_API_KEY_KEY_ID
      APP_STORE_CONNECT_API_KEY_ISSUER_ID
    ]
  )

  key_content = ENV['APP_STORE_CONNECT_API_KEY_KEY_CONTENT'].to_s.strip
  key_filepath = ENV['APP_STORE_CONNECT_API_KEY_KEY_FILEPATH'].to_s.strip

  if key_content.empty? && key_filepath.empty?
    UI.user_error!('Set APP_STORE_CONNECT_API_KEY_KEY_CONTENT or APP_STORE_CONNECT_API_KEY_KEY_FILEPATH')
  end

  key_config = {
    key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
    issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
    duration: 1200,
    in_house: false
  }

  unless key_content.empty?
    key_config[:key_content] = key_content
    key_config[:is_key_content_base64] = ENV['APP_STORE_CONNECT_API_KEY_IS_BASE64'].to_s.downcase == 'true'
  end

  key_config[:key_filepath] = key_filepath unless key_filepath.empty?

  app_store_connect_api_key(**key_config)
end

private_lane :release_changelog do
  changelog_from_git_commits(
    pretty: '- %s',
    commits_count: 15,
    merge_commit_filtering: 'exclude_merges'
  )
end

platform :ios do
  desc 'Increment build number, archive and upload to TestFlight, then tag the release'
  lane :deploy_testflight do
    ensure_git_status_clean

    scheme = ENV['IOS_SCHEME'].to_s.strip
    scheme = DEFAULT_SCHEME if scheme.empty?

    target = ENV['IOS_APP_TARGET'].to_s.strip
    target = DEFAULT_TARGET if target.empty?

    api_key = resolve_app_store_api_key

    build_number = increment_build_number(xcodeproj: PROJECT_PATH)
    version_number = get_version_number(xcodeproj: PROJECT_PATH, target: target)
    changelog = release_changelog

    commit_message = "chore(release): bump iOS build to #{build_number}"
    git_commit(
      path: ['romm/romm.xcodeproj/project.pbxproj'],
      message: commit_message
    )

    build_app(
      project: PROJECT_PATH,
      scheme: scheme,
      configuration: 'Release',
      clean: true,
      export_method: 'app-store',
      output_directory: 'build',
      output_name: 'romm.ipa'
    )

    upload_to_testflight(
      api_key: api_key,
      changelog: changelog,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false
    )

    tag_name = "ios/v#{version_number}-b#{build_number}"
    add_git_tag(
      tag: tag_name,
      message: "TestFlight upload #{tag_name}"
    )

    if ENV['FASTLANE_PUSH_AFTER_DEPLOY'].to_s.downcase == 'true'
      push_to_git_remote(tags: true)
    end

    UI.success("Upload complete. Created commit and tag #{tag_name}")
  end

  desc 'Convenience alias for deploy_testflight'
  lane :deploy do
    deploy_testflight
  end

  desc 'Create App Store screenshots (Login + Settings) via snapshot'
  lane :screenshots do
    snapshot
  end
end
