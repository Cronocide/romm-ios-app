# Snapshot configuration for deterministic marketing screenshots

devices([
  'iPhone 16 Pro'
])

languages([
  'en-US'
])

project('romm/romm.xcodeproj')
scheme('romm')

override_status_bar(true)
clear_previous_screenshots(true)
erase_simulator(true)
reinstall_app(true)
stop_after_first_error(true)

# Run only the dedicated screenshot test
only_testing(['rommUITests/testTakeScreenshots'])

# Snapshot helper already injects -FASTLANE_SNAPSHOT / -ui_testing
output_directory('./fastlane/screenshots')
