# App Store Connect API key (preferred)
APP_STORE_CONNECT_API_KEY_KEY_ID=YOUR_KEY_ID
APP_STORE_CONNECT_API_KEY_ISSUER_ID=YOUR_ISSUER_ID

# Provide one of these two options:
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=fastlane/AuthKey_XXXXXXXXXX.p8
# APP_STORE_CONNECT_API_KEY_KEY_CONTENT=

# Optional: set true when APP_STORE_CONNECT_API_KEY_KEY_CONTENT is base64 encoded
APP_STORE_CONNECT_API_KEY_IS_BASE64=false

# Optional fallback for Apple ID auth
FASTLANE_APPLE_ID=your-apple-id@example.com

# Optional overrides
IOS_SCHEME=romm
IOS_APP_TARGET=romm
FASTLANE_PUSH_AFTER_DEPLOY=false
